# ──────────────────────────────────────────────
#  Photo Tracking Server - Environment Variables
# ──────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/photo_tracking

# Upload
MAX_FILE_SIZE=10485760

# Tracking
TRACKING_PREFIX=PTK

# Security
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Webhook (Phase 2+)
WEBHOOK_URL=

# Email / SMTP (Phase 2+)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=
